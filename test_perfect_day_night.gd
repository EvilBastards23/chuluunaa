func _input(event):
	if event is InputEventKey and event.pressed:
		match event.keycode:
			KEY_I:
				print("🌙 Toggling PERFECT day/night...")
			KEY_H:
				show_help()
			KEY_D:
				show_day_details()
			KEY_N:
				show_night_details()

