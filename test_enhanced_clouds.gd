func _input(event):
	if event is InputEventKey and event.pressed:
		match event.keycode:
			KEY_I:
				print("🌙 Testing enhanced cloud transitions...")
			KEY_H:
				show_help()
			KEY_C:
				show_cloud_details()
			KEY_S:
				show_speed_details()

