func _input(event):
	if event is InputEventKey and event.pressed:
		match event.keycode:
			KEY_I:
				print("☁️ Testing natural cloud coverage...")
			KEY_H:
				show_help()
			KEY_D:
				show_density_details()
			KEY_G:
				show_gap_details()
			KEY_P:
				show_pattern_details()

