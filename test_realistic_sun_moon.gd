func _input(event):
	if event is InputEventKey and event.pressed:
		match event.keycode:
			KEY_I:
				print("🌞 Testing realistic sun/moon/cloud system...")
			KEY_H:
				show_help()
			KEY_S:
				show_size_details()
			KEY_D:
				show_distance_details()
			KEY_C:
				show_cloud_details()

