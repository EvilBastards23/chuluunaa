func _input(event):
	if event is InputEventKey and event.pressed:
		match event.keycode:
			KEY_I:
				print("☁️ Testing professional cloud quality...")
			KEY_H:
				show_help()
			KEY_R:
				show_resolution_details()
			KEY_Q:
				show_quality_details()
			KEY_S:
				show_sampling_details()

