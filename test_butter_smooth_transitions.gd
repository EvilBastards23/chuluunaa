func _input(event):
	if event is InputEventKey and event.pressed:
		match event.keycode:
			KEY_I:
				print("🌙 Starting butter-smooth transition...")
			KEY_H:
				show_help()
			KEY_T:
				show_timing_details()
			KEY_E:
				show_easing_details()

