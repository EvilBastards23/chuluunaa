func _input(event):
	if event is InputEventKey and event.pressed:
		match event.keycode:
			KEY_I:
				print("☁️ Testing restored professional cloud system...")
			KEY_H:
				show_help()
			KEY_R:
				show_restored_details()
			KEY_P:
				show_professional_details()
			KEY_Q:
				show_quality_details()

