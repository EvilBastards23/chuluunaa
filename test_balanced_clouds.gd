func _input(event):
	if event is InputEventKey and event.pressed:
		match event.keycode:
			KEY_I:
				print("☁️ Testing balanced cloud system...")
			KEY_H:
				show_help()
			KEY_B:
				show_balance_details()
			KEY_Q:
				show_quality_details()
			KEY_G:
				show_gap_details()

