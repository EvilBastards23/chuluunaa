func _input(event):
	if event is InputEventKey and event.pressed:
		match event.keycode:
			KEY_I:
				print("🌅 Testing RDR2-style day/night transitions...")
			KEY_H:
				show_help()
			KEY_R:
				show_rdr2_details()
			KEY_S:
				show_settings_details()
			KEY_C:
				show_color_details()

