func _input(event):
	if event is InputEventKey and event.pressed:
		match event.keycode:
			KEY_I:
				print("🌙 Starting smooth transition...")
			KEY_H:
				show_help()
			KEY_D:
				show_day_details()
			KEY_T:
				show_transition_details()

