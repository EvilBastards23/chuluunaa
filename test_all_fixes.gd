func _input(event):
	if event is InputEventKey and event.pressed:
		match event.keycode:
			KEY_I:
				print("🌙 Testing perfect transitions...")
			KEY_H:
				show_help()
			KEY_F:
				show_fixes()
			KEY_T:
				show_transition_details()
			KEY_C:
				show_cloud_details()

