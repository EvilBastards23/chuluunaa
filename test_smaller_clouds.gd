func _input(event):
	if event is InputEventKey and event.pressed:
		match event.keycode:
			KEY_I:
				print("☁️ Testing smaller cloud system...")
			KEY_H:
				show_help()
			KEY_S:
				show_size_details()
			KEY_G:
				show_gap_details()
			KEY_C:
				show_coverage_details()

